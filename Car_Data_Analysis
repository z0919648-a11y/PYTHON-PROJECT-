      "source": [
        "import pandas as pd\n",
        "\n",
        "url = \"https://raw.githubusercontent.com/selva86/datasets/master/mpg_ggplot2.csv\"\n",
        "\n",
        "df = pd.read_csv(url)\n",
        "\n",
        "print(df.head())\n",
        "\n",
        "print (df.tail())\n",
        "\n",
        "print (df.describe())\n",
        "\n",
        "print (df.info())\n",
        "\n",
        "print (df.columns)\n",
        "\n",
        "print (df.shape)\n",
        "\n",
        "print(df[\"hwy\"].max())\n",
        "\n",
        "print(df[\"hwy\"].min())\n",
        "\n",
        "print(df[\"hwy\"].mean())\n",
        "\n",
        "toyota = df[df[\"manufacturer\"]  == \"toyota\"]\n",
        "\n",
        "print(toyota.head())\n",
        "print(toyota.tail())\n",
        "print(toyota[\"hwy\"].max())\n",
        "\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "plt.figure(figsize=(10,5))\n",
        "plt.plot(toyota[\"model\"],toyota[\"hwy\"])\n",
        "\n",
        "plt.title(\"toyota highway Mileage\")\n",
        "plt.xlabel(\"Model\")\n",
        "plt.ylabel(\"Highway MPG\")\n",
        "\n",
        "plt.xticks(rotation=45)\n",
        "plt.show()\n",
        "\n",
        "plt.figure(figsize=(10,5))\n",
        "\n",
        "plt.plot(toyota[\"model\"], toyota[\"cty\"])\n",
        "\n",
        "plt.title(\"Toyota City Mileage\")\n",
        "plt.xlabel(\"Model\")\n",
        "plt.ylabel(\"City MPG\")\n",
        "\n",
        "plt.xticks(rotation=45)\n",
        "plt.show()\n",
        "\n",
        "plt.figure(figsize=(8,8))\n",
        "\n",
        "toyota[\"drv\"].value_counts().plot(\n",
        "    kind=\"pie\",\n",
        "    autopct=\"%1.1f%%\"\n",
        ")\n",
        "\n",
        "plt.title(\"Toyota Drive Type\")\n",
        "plt.ylabel(\"\")\n",
        "\n",
        "plt.show()\n",
        "\n",
        "plt.figure(figsize=(8,8))\n",
        "\n",
        "df[\"class\"].value_counts().plot(\n",
        "    kind=\"pie\",\n",
        "    autopct=\"%1.1f%%\"\n",
        ")\n",
        "\n",
        "plt.title(\"Car Classes\")\n",
        "plt.ylabel(\"\")\n",
        "\n",
        "plt.show()"
